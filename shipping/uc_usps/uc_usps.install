  $config->set('uc_usps_client_id', '');
  $config->set('uc_usps_client_secret', '');
  $config->set('uc_usps_connection_address', 'https://apis.usps.com/oauth2/v3/token');
  $config->set('uc_usps_token_expiry', 0);

  $config->set('uc_usps_newapi_dom_env_all_services', array(
    'FCLM' => 'First Class Letter Metered',
